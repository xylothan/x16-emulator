rom.bin
# Where build.ps1 -FetchRom and the CI fetch-rom action drop the ROM image and
# its symbol files. Downloaded per build, never committed.
/latest_rom/
src/rom_labels.h
src/rom_lst.h
src/basload_labels.h
src/x16edit_D_labels.h
src/x16edit_E_labels.h
.vscode/
.idea/
/build
/out

# Visual Studio
.vs/
*.vcxproj.user
*.suo
*.ncb
*.sdf
*.opensdf

imgui.ini

# Klaus Dormann's functional test images, fetched by tests/fetch_klaus.py.
# GPL-licensed and 64K each, so downloaded rather than committed.
/tests/klaus/

# SingleStepTests/ProcessorTests. The downloaded JSON is gigabytes and stays
# out; the converted fixtures are a couple of megabytes each and are committed,
# so the tests run offline and CI does not re-download 3.6 GB to rebuild them.
# Regenerate with tests/fetch_pt.py --force.
/tests/pt/*
!/tests/pt/*.bin
!/tests/pt/README.md
pt-report*.txt

# VERA Verilog, fetched by tests/fetch_vera_rtl.py. Someone else's repository
# under its own licence, and reference material rather than part of the build.
# The VERA tests quote the lines they rest on, so nothing depends on it being
# present -- it is here so a reviewer can check a citation.
/tests/vera-rtl/

# Datasheets and tutorials, fetched by tests/refs/fetch_refs.py. Copyright
# Western Design Center and Bruce Clark respectively, so downloaded rather
# than committed. The tests cite page numbers; this is what makes a citation
# checkable.
/tests/refs/downloads/

__pycache__/
*.pyc
