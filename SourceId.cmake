# SourceId.cmake: writes OUTPUT_FILE, a C source defining x16_source_id, a
# SHA-256 over every file listed in LIST_FILE (path relative to SOURCE_DIR,
# then the file's own hash). Save states use it to tell builds apart: any change
# to any source gives a new ID, and identical sources give the same one.

file(READ "${LIST_FILE}" inputs)
list(SORT inputs)
set(all "")
foreach(f IN LISTS inputs)
    if(EXISTS "${f}")
        file(SHA256 "${f}" h)
        file(RELATIVE_PATH rel "${SOURCE_DIR}" "${f}")
        string(APPEND all "${rel} ${h}\n")
    endif()
endforeach()
string(SHA256 id "${all}")
file(WRITE "${OUTPUT_FILE}"
    "// Generated by SourceId.cmake: a hash of the emulator's sources.\n"
    "const char x16_source_id[] = \"${id}\";\n")
