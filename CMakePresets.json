{
  "version": 3,
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "ENABLE_FLUIDSYNTH": "OFF"
      }
    },
    {
      "name": "vs2022",
      "inherits": "msvc-base",
      "displayName": "Visual Studio 2022 (x64)",
      "description": "MSVC build with dependencies from vcpkg. Requires VCPKG_ROOT to be set.",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "vs2026",
      "inherits": "msvc-base",
      "displayName": "Visual Studio 2026 (x64)",
      "description": "As vs2022, for Visual Studio 2026. Needs a CMake new enough to know this generator (4.0+).",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "ninja",
      "inherits": "msvc-base",
      "displayName": "Ninja Multi-Config (x64)",
      "description": "Faster local builds. Run from a Developer Command Prompt so the MSVC toolchain is on PATH.",
      "generator": "Ninja Multi-Config"
    }
  ],
  "buildPresets": [
    { "name": "vs2022-debug",  "configurePreset": "vs2022", "configuration": "Debug" },
    { "name": "vs2022-release","configurePreset": "vs2022", "configuration": "Release" },
    { "name": "vs2026-debug",  "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "vs2026-release","configurePreset": "vs2026", "configuration": "Release" },
    { "name": "ninja-debug",   "configurePreset": "ninja",  "configuration": "Debug" },
    { "name": "ninja-release", "configurePreset": "ninja",  "configuration": "Release" }
  ]
}